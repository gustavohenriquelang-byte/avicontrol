# =========================================================
# Avicontrol - variáveis de ambiente
# Copie este arquivo para .env.local e preencha com os
# valores do seu projeto Supabase (Project Settings > API).
# =========================================================

# URL do projeto Supabase (ex.: https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (anon) — pode ir para o cliente
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço (service_role) — NUNCA expor no cliente.
# Usada apenas em rotas/servidor para operações administrativas
# (ex.: convites de usuário, seed, jobs).
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site (usada nos links de e-mail de recuperação de senha)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Nome exibido na aplicação (opcional)
NEXT_PUBLIC_APP_NAME=Avicontrol

# Timezone padrão da interface
NEXT_PUBLIC_DEFAULT_TIMEZONE=America/Sao_Paulo
